# hd1k slices on a Windows volume (L:) whose partition starts after the 1 MB prefix.
# Slice N offset = 1024 * N tracks (no +128T; the volume already begins at slice 0).

diskdef wbw_hd1k_vol_0
  seclen 512
  tracks 1024
  sectrk 16
  blocksize 4096
  maxdir 1024
  skew 0
  boottrk 2
  offset 0T
  os 2.2
end


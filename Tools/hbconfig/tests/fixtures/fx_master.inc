;
; HBCONFIG TEST FIXTURE - mini "master" file with ;@ tags
; Not part of any ROMWBW build; exercised by tests/test-tags.sh.
;
MD_ALPHA    .EQU    0       ; MODE ALPHA
MD_BETA     .EQU    1       ; MODE BETA
MD_GAMMA    .EQU    2       ; MODE GAMMA
;
FOOENABLE   .EQU    FALSE   ; ENABLE THE FOO DRIVER ;@DEPENDS BARENABLE || BAZENABLE
FOOADDR     .EQU    $80     ; FOO BASE ADDRESS ;@DEPENDS INTMODE <= 3
FOOMODE     .EQU    MD_ALPHA ; FOO MODE: MD_[ALPHA|BETA|GAMMA]
;
; conditional rule on a following line (RULES.md 4):
BARENABLE   .EQU    FALSE   ; ENABLE THE BAR DRIVER
;@DEPENDS INTMODE != 0 || TICKFREQ = 50
;@HELP BAR REQUIRES INTERRUPTS UNLESS THE TICK RUNS AT 50 HZ.
;@HELP
;@HELP (SECOND PARAGRAPH OF HELP.)
;
MULTI       .EQU    TRUE    ; MULTI-TAG SETTING ;@DEPENDS RAMSIZE >= 64 ;@DEPENDS ROMSIZE < 1024
;

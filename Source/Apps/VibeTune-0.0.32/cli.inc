CLI_PREP:
	LD	A,($80)			; CP/M command tail length byte
	CP	128
	JR	C,CLI_PREP0
	LD	A,127			; clamp malformed tails to the max usable span
CLI_PREP0:
	LD	B,A
	LD	HL,CLIARGS		; COMMAND TAIL START
	LD	DE,CLIBUF
CLI_PREP1:
	LD	A,B
	OR	A
	JR	Z,CLI_PREP3
	LD	A,(HL)
	CP	13			; CR TERMINATOR
	JR	Z,CLI_PREP3
	OR	A			; ALLOW NUL-TERMINATED TAILS TOO
	JR	Z,CLI_PREP3
	CP	'a'
	JR	C,CLI_PREP2
	CP	'z'+1
	JR	NC,CLI_PREP2
	SUB	32			; normalize command tail to upper-case for option parsing
CLI_PREP2:
	LD	(DE),A
	INC	HL
	INC	DE
	DEC	B
	JR	CLI_PREP1
CLI_PREP3:
	XOR	A
	LD	(DE),A			; NUL TERMINATE
	CALL	CLI_BUILD_FCB_FROM_TAIL
	RET

CLI_BUILD_FCB_FROM_TAIL:
	LD	HL,FCB
	XOR	A
	LD	(HL),A
	INC	HL
	LD	B,11
CLI_BUILD_FCB_FROM_TAIL0:
	LD	(HL),' '
	INC	HL
	DJNZ	CLI_BUILD_FCB_FROM_TAIL0
	XOR	A
	LD	B,24
CLI_BUILD_FCB_FROM_TAIL1:
	LD	(HL),A
	INC	HL
	DJNZ	CLI_BUILD_FCB_FROM_TAIL1
	LD	HL,CLIBUF
CLI_BUILD_FCB_FROM_TAIL2:
	LD	A,(HL)
	OR	A
	RET	Z
	CP	' '
	JR	NZ,CLI_BUILD_FCB_FROM_TAIL3
	INC	HL
	JR	CLI_BUILD_FCB_FROM_TAIL2
CLI_BUILD_FCB_FROM_TAIL3:
	CP	'-'
	JR	Z,CLI_BUILD_FCB_SKIPTOK
	CP	'+'
	JR	Z,CLI_BUILD_FCB_SKIPTOK
	LD	DE,FCB+1
	LD	B,8
CLI_BUILD_FCB_NAME:
	LD	A,(HL)
	OR	A
	RET	Z
	CP	' '
	RET	Z
	CP	'.'
	JR	Z,CLI_BUILD_FCB_EXT0
	LD	(DE),A
	INC	DE
	INC	HL
	DJNZ	CLI_BUILD_FCB_NAME
CLI_BUILD_FCB_NAME1:
	LD	A,(HL)
	OR	A
	RET	Z
	CP	' '
	RET	Z
	CP	'.'
	JR	Z,CLI_BUILD_FCB_EXT0
	INC	HL
	JR	CLI_BUILD_FCB_NAME1
CLI_BUILD_FCB_EXT0:
	INC	HL
	LD	DE,FCB+9
	LD	B,3
CLI_BUILD_FCB_EXT1:
	LD	A,(HL)
	OR	A
	RET	Z
	CP	' '
	RET	Z
	LD	(DE),A
	INC	DE
	INC	HL
	DJNZ	CLI_BUILD_FCB_EXT1
	RET
CLI_BUILD_FCB_SKIPTOK:
	INC	HL
CLI_BUILD_FCB_SKIPTOK1:
	LD	A,(HL)
	OR	A
	RET	Z
	CP	' '
	JR	Z,CLI_BUILD_FCB_FROM_TAIL2
	INC	HL
	JR	CLI_BUILD_FCB_SKIPTOK1

CLI_HAVE_CREDITS_SWITCH:
	LD	HL, CLIBUF		; TEST FOR -CREDITS ON COMMAND LINE
	LD	DE, CREDOPT1
	CALL	STRINDEX
	JR	Z, CLI_HAVE_CREDITS_SWITCH1
	LD	HL, CLIBUF		; TEST FOR --CREDITS ON COMMAND LINE
	LD	DE, CREDOPT2
	CALL	STRINDEX
	JR	NZ, CLI_HAVE_CREDITS_SWITCH2
CLI_HAVE_CREDITS_SWITCH1:
	OR	$FF			; MATCHED -CREDITS / -credits
	LD	(CREDMD), A
	RET
CLI_HAVE_CREDITS_SWITCH2:
	XOR	A
	LD	(CREDMD), A
	RET

CLI_HAVE_ALL_SWITCH:
	LD	HL, CLIBUF		; TEST FOR -LIST ON COMMAND LINE
	LD	DE, LISTOPT1
	CALL	STRINDEX
	JR	Z, CLI_HAVE_ALL_SWITCH1
	LD	HL, CLIBUF		; TEST FOR --LIST ON COMMAND LINE
	LD	DE, LISTOPT2
	CALL	STRINDEX
	JR	Z, CLI_HAVE_ALL_SWITCH1
	LD	HL, CLIBUF		; LEGACY: TEST FOR -ALL ON COMMAND LINE
	LD	DE, ALLOPT1
	CALL	STRINDEX
	JR	Z, CLI_HAVE_ALL_SWITCH1
	LD	HL, CLIBUF		; LEGACY: TEST FOR --ALL ON COMMAND LINE
	LD	DE, ALLOPT2
	CALL	STRINDEX
	JR	NZ, CLI_HAVE_ALL_SWITCH2
CLI_HAVE_ALL_SWITCH1:
	OR	$FF			; MATCHED -LIST / -list (or legacy -ALL)
	LD	(ALLMD), A
	RET
CLI_HAVE_ALL_SWITCH2:
	XOR	A
	LD	(ALLMD), A
	RET

CLI_HAVE_LOOP_SWITCH:
 	LD	HL, CLIBUF		; TEST FOR -LOOP ON COMMAND LINE
	LD	DE, LOOPOPT1
	CALL	STRINDEX
	JR	Z, CLI_HAVE_LOOP_SWITCH1
 	LD	HL, CLIBUF		; TEST FOR --LOOP ON COMMAND LINE
	LD	DE, LOOPOPT2
	CALL	STRINDEX
	JR	NZ, CLI_HAVE_LOOP_SWITCH2
CLI_HAVE_LOOP_SWITCH1:
	LD	A,(ALLMD)
	OR	A
	JR	Z,CLI_HAVE_LOOP_SWITCH1A
	OR	$FF			; MATCHED -LOOP / -loop in playlist mode
	LD	(LOOPPLMD),A
	XOR	A
	LD	(LOOPTRKMD),A
	RET
CLI_HAVE_LOOP_SWITCH1A:
	OR	$FF			; MATCHED -LOOP / -loop in single-track mode
	LD	(LOOPTRKMD),A
	XOR	A
	LD	(LOOPPLMD),A
	RET
CLI_HAVE_LOOP_SWITCH2:
	XOR	A
	LD	(LOOPTRKMD), A
	LD	(LOOPPLMD), A
	RET

CLI_HAVE_CONFIG_SWITCH:
 	LD	HL, CLIBUF		; TEST FOR -CONFIG ON COMMAND LINE
	LD	DE, CFGOPT1
	CALL	STRINDEX
	JR	Z, CLI_HAVE_CONFIG_SWITCH1
 	LD	HL, CLIBUF		; TEST FOR --CONFIG ON COMMAND LINE
	LD	DE, CFGOPT2
	CALL	STRINDEX
	JR	NZ, CLI_HAVE_CONFIG_SWITCH2
CLI_HAVE_CONFIG_SWITCH1:
	OR	$FF			; MATCHED -CONFIG / -config
	LD	(CONFIGMD), A
	RET
CLI_HAVE_CONFIG_SWITCH2:
	XOR	A
	LD	(CONFIGMD), A
	RET

CLI_ABRT_IF_OPT_FIRST:
	LD	A, (FCB+1)
	CP	'-'			; OPTION FIRST OR - MISSING FILENAME?
	RET	NZ
	LD	A,(ALLMD)
	OR	A
	RET	NZ			; ALLOW OPTION-FIRST WHEN -LIST IS USED
	LD	A,(CONFIGMD)
	OR	A
	RET	NZ			; ALLOW OPTION-FIRST WHEN -config IS USED
	JP	ERRCMD			; SHOW USAGE
	RET

CLI_HAVE_HBIOS_SWITCH:
 	LD	HL, CLIBUF		; TEST FOR --HBIOS ON COMMAND LINE
	LD	DE, HBIOSOPT
	CALL	STRINDEX
	JR	NZ, CLI_HAVE_HBIOS_SWITCH1
	OR	$FF			; MATCHED --HBIOS
	LD	(HBIOSMD), A
	LD	BC,(BF_SYSGET*256)+BF_SND
	RST	08			; CHECK WE HAVE
	XOR	A			; AT LEAST ONE
	CP	E			; SOUND DEVICE
	RET	NZ
	JP	ERRHW
CLI_HAVE_HBIOS_SWITCH1			; NOT MATCHED --HBIOS
	XOR	A
	LD	(HBIOSMD), A
	RET

CLI_HAVE_DELAY_SWITCH:
 	LD	HL, CLIBUF		; TEST FOR --DELAY ON COMMAND LINE
	LD	DE, DELAYOPT
	CALL	STRINDEX
	JR	NZ, CLI_HAVE_DELAY_SWITCH1
	OR	$FF			; MATCHED --DELAY
	LD	(DELAYMD), A
	RET
CLI_HAVE_DELAY_SWITCH1			; NOT MATCHED --DELAY
	XOR	A
	LD	(DELAYMD), A
	RET

CLI_HAVE_YM2151_SWITCH:
	LD	HL, CLIBUF		; TEST FOR -YMFF ON COMMAND LINE
	LD	DE, OPT_YMFF1
	CALL	STRINDEX
	JR	Z, CLI_HAVE_YM2151_SWITCH_FF
	LD	HL, CLIBUF		; TEST FOR --YMFF ON COMMAND LINE
	LD	DE, OPT_YMFF2
	CALL	STRINDEX
	JR	Z, CLI_HAVE_YM2151_SWITCH_FF
	LD	HL, CLIBUF		; TEST FOR -YMDE ON COMMAND LINE
	LD	DE, OPT_YMDE1
	CALL	STRINDEX
	JR	Z, CLI_HAVE_YM2151_SWITCH_DE
	LD	HL, CLIBUF		; TEST FOR --YMDE ON COMMAND LINE
	LD	DE, OPT_YMDE2
	CALL	STRINDEX
	JR	Z, CLI_HAVE_YM2151_SWITCH_DE
	RET				; default YM2151MAP kept as-is (0 => DE/DF)
CLI_HAVE_YM2151_SWITCH_FF:
	LD	A,1
	LD	(YM2151MAP),A
	RET
CLI_HAVE_YM2151_SWITCH_DE:
	XOR	A
	LD	(YM2151MAP),A
	RET

CLI_PORTS:
 	LD	HL, CLIBUF		; TEST FOR -MSX ON COMMAND LINE
	LD	DE, OPT_MSX
	CALL	STRINDEX
	JR	NZ, CLI_PORTS1
	LD	A,PORTS_MSX
	JR	CLI_PORTS_Z
CLI_PORTS1:
 	LD	HL, CLIBUF		; TEST FOR -RC ON COMMAND LINE
	LD	DE, OPT_RC
	CALL	STRINDEX
	JR	NZ, CLI_PORTS2
	LD	A,PORTS_RC
	JR	CLI_PORTS_Z
CLI_PORTS2:
 	LD	HL, CLIBUF		; TEST FOR -COLECO ON COMMAND LINE
	LD	DE, OPT_COLECO
	CALL	STRINDEX
	JR	NZ, CLI_PORTS3
	LD	A,PORTS_COLECO
	JR	CLI_PORTS_Z
CLI_PORTS3:
	LD	A,PORTS_AUTO		; USE AUTO PORT SELECTION
CLI_PORTS_Z:
	LD	(USEPORTS),A		; SAVE PORTS SELECTION
	RET

CLI_ABRT_UNSUPPFILTYP:
	PUSH	AF
	ISHBIOS
	JR	Z, CLI_ABRT_UNSUPPFILTYP1
	POP	AF
	CP	TYPMYM
	RET	NZ
	ERRWITHMSG(MSGUNSUP)		; EXIT WITH UNSUPPORTED FILE TYPE MESSAGE

CLI_ABRT_UNSUPPFILTYP1:
	POP	AF
	RET

CLI_OCTAVE_ADJST:			; SEARCH FOR OCTAVE ADJUSTMENT SWITCH (-n or +n)
	LD	HL, CLIBUF		; TEST FOR --HBIOS ON COMMAND LINE
	LD	DE, DOWN1
	CALL	STRINDEX
	JR	NZ, CLI_OCTAVE_ADJST1

	LD	A, -1
	JR 	CLI_OCTAVE_ADJST5

CLI_OCTAVE_ADJST1:
	LD	HL, CLIBUF		; TEST FOR --HBIOS ON COMMAND LINE
	LD	DE, DOWN2
	CALL	STRINDEX
	JR	NZ, CLI_OCTAVE_ADJST2

	LD	A, -2
	JR 	CLI_OCTAVE_ADJST5

CLI_OCTAVE_ADJST2:
	LD	HL, CLIBUF		; TEST FOR --HBIOS ON COMMAND LINE
	LD	DE, UP1
	CALL	STRINDEX
	JR	NZ, CLI_OCTAVE_ADJST3

	LD	A, 1
	JR 	CLI_OCTAVE_ADJST5

CLI_OCTAVE_ADJST3:
	LD	HL, CLIBUF		; TEST FOR --HBIOS ON COMMAND LINE
	LD	DE, UP2
	CALL	STRINDEX
	JR	NZ, CLI_OCTAVE_ADJST4

	LD	A, 2
	JR 	CLI_OCTAVE_ADJST5

CLI_OCTAVE_ADJST4:
	LD	A, 0

CLI_OCTAVE_ADJST5:
	LD	(OCTAVEADJ), A
	RET

OPT_MSX		.DB	"-MSX", 0			; USE MSX PORTS
OPT_RC		.DB	"-RC", 0			; USE RC PORTS
OPT_COLECO	.DB	"-COLECO", 0		; USE COLECO AY PORTS (50H/51H)
OPT_YMDE1	.DB	"-YMDE", 0			; USE YM2151 PORTS DEH/DFH
OPT_YMDE2	.DB	"--YMDE", 0			; USE YM2151 PORTS DEH/DFH
OPT_YMFF1	.DB	"-YMFF", 0			; USE YM2151 PORTS FEH/FFH
OPT_YMFF2	.DB	"--YMFF", 0			; USE YM2151 PORTS FEH/FFH
LISTOPT1	.DB	"-LIST", 0			; ENUMERATE/PLAY ALL SUPPORTED FILES
LISTOPT2	.DB	"--LIST", 0			; ENUMERATE/PLAY ALL SUPPORTED FILES
ALLOPT1		.DB	"-ALL", 0			; LEGACY ALIAS FOR -LIST
ALLOPT2		.DB	"--ALL", 0			; LEGACY ALIAS FOR -LIST
LOOPOPT1	.DB	"-LOOP", 0			; LOOP PLAYBACK
LOOPOPT2	.DB	"--LOOP", 0			; LOOP PLAYBACK
CFGOPT1		.DB	"-CONFIG", 0		; TERM.CFG CONFIG MODE
CFGOPT2		.DB	"--CONFIG", 0		; TERM.CFG CONFIG MODE
CREDOPT1	.DB	"-CREDITS", 0		; SHOW CREDITS
CREDOPT2	.DB	"--CREDITS", 0		; SHOW CREDITS
HBIOSOPT:	.DB	"--HBIOS", 0		; USE HBIOS API FOR PLAYBACK
DELAYOPT:	.DB	"-DELAY",0			; FORCE DELAY MODE
DOWN1		.DB	"-T1", 0			; DOWN AN OCTAVE
DOWN2		.DB	"-T2", 0			; DOWN TWO OCTAVE
UP1		.DB	"+T1", 0				; UP AN OCTAVE
UP2		.DB	"+T2", 0				; UP TWO OCTAVE

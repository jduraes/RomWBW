;
; VGM hardware detection and summary helpers.
; Extracted from vibetune.asm as a behavior-preserving include.
;

; Detect VGM chip usage from the actual command stream.
; Sets VGMCHIPFLG bits:
;   bit 0: OPL2 (YM3812)
;   bit 1: OPL3 (YMF262)
;   bit 2: AY-3-8910 / YM2149
;   bit 3: SN76489
;   bit 4: YM2151 (OPM)
;
VGM_DETECT_HW:
	XOR	A
	LD	(VGMCHIPFLG),A
	LD	(VGMDUALFLG),A
	LD	(VGMRDERR),A
	CALL	VGM_GET_STREAM_START	; C:HL logical stream start
	LD	(vgmpos),HL
	LD	A,C
	LD	(vgmpos+2),A
VGM_DET_LP:
	CALL	VGM_RD_NEXT_EX
	CP	66H
	RET	Z
	CP	4FH
	JP	Z,VGM_DET_S1
	CP	50H
	JP	Z,VGM_DET_SN1
	CP	30H
	JP	Z,VGM_DET_SN2
	CP	5AH
	JP	Z,VGM_DET_OPL2
	CP	5EH
	JP	Z,VGM_DET_OPL31
	CP	5FH
	JP	Z,VGM_DET_OPL32
	CP	0A0H
	JP	Z,VGM_DET_AY
	CP	054H
	JP	Z,VGM_DET_2151
	CP	0A4H
	JP	Z,VGM_DET_21512
	CP	61H
	JP	Z,VGM_DET_S2
	CP	62H
	JP	Z,VGM_DET_LP
	CP	63H
	JP	Z,VGM_DET_LP
	CP	70H
	JP	NC,VGM_DET_WAIT
	JP	VGM_DET_SKIP
VGM_DET_WAIT:
	CP	80H
	JP	C,VGM_DET_LP
	JP	VGM_DET_SKIP
VGM_DET_S1:
	LD	A,1
	CALL	VGM_POS_ADD_A
	JP	VGM_DET_LP
VGM_DET_S2:
	LD	A,2
	CALL	VGM_POS_ADD_A
	JP	VGM_DET_LP
VGM_DET_SN1:
	LD	A,(VGMCHIPFLG)
	OR	00001000B
	LD	(VGMCHIPFLG),A
	LD	A,1
	CALL	VGM_POS_ADD_A
	JP	VGM_DET_LP
VGM_DET_SN2:
	LD	A,(VGMCHIPFLG)
	OR	00001000B
	LD	(VGMCHIPFLG),A
	LD	A,(VGMDUALFLG)
	OR	00001000B
	LD	(VGMDUALFLG),A
	LD	A,1
	CALL	VGM_POS_ADD_A
	JP	VGM_DET_LP
VGM_DET_OPL2:
	LD	A,(VGMCHIPFLG)
	OR	00000001B
	LD	(VGMCHIPFLG),A
	LD	A,2
	CALL	VGM_POS_ADD_A
	JP	VGM_DET_LP
VGM_DET_OPL31:
VGM_DET_OPL32:
	LD	A,(VGMCHIPFLG)
	OR	00000010B
	LD	(VGMCHIPFLG),A
	LD	A,2
	CALL	VGM_POS_ADD_A
	JP	VGM_DET_LP
VGM_DET_AY:
	LD	A,(VGMCHIPFLG)
	OR	00000100B
	LD	(VGMCHIPFLG),A
	CALL	VGM_RD_NEXT_EX		; register byte (bit7 = chip 2)
	BIT	7,A
	JR	Z,VGM_DET_AY0
	LD	A,(VGMDUALFLG)
	OR	00000100B
	LD	(VGMDUALFLG),A
VGM_DET_AY0:
	LD	A,1
	CALL	VGM_POS_ADD_A		; skip data byte
	JP	VGM_DET_LP
VGM_DET_2151:
VGM_DET_21512:
	LD	A,(VGMCHIPFLG)
	OR	00010000B
	LD	(VGMCHIPFLG),A
	LD	A,2
	CALL	VGM_POS_ADD_A
	JP	VGM_DET_LP

VGM_DET_SKIP:
	CALL	VGM_SKIP_UNK
	JP	VGM_DET_LP

; Print VGM hardware line after MSGTSPRE, listing detected chips.
PRT_VGMHW_LINE:
	LD	DE,MSGTSPRE
	CALL	PRTSTR
	XOR	A
	LD	(VGMPRNSEP),A
	LD	A,(VGMCHIPFLG)
	OR	A
	JR	NZ,PRT_VGMHW0
	LD	DE,MSGVGMUNK
	JP	PRTSTR
PRT_VGMHW0:
	; A still valid from LD A,(VGMCHIPFLG) above
	BIT	1,A
	JR	Z,PRT_VGMHW1
	LD	DE,MSGVGMOPL3
	CALL	PRT_VGM_TOKEN
PRT_VGMHW1:
	LD	A,(VGMCHIPFLG)		; reload: A clobbered by PRT_VGM_TOKEN
	BIT	0,A
	JR	Z,PRT_VGMHW2
	LD	DE,MSGVGMOPL2
	CALL	PRT_VGM_TOKEN
PRT_VGMHW2:
	LD	A,(VGMCHIPFLG)
	BIT	2,A
	JR	Z,PRT_VGMHW3
	LD	DE,MSGVGMAY
	CALL	PRT_VGM_TOKEN
PRT_VGMHW3:
	LD	A,(VGMCHIPFLG)
	BIT	4,A
	JR	Z,PRT_VGMHWPSG
	LD	DE,MSGVGM2151
	CALL	PRT_VGM_TOKEN
PRT_VGMHWPSG:
	LD	A,(VGMCHIPFLG)
	BIT	3,A
	JR	Z,PRT_VGMHW4
	LD	A,(VGMDUALFLG)
	BIT	3,A
	JR	Z,PRT_VGMHWPSG1
	LD	DE,MSGVGMPSG2
	CALL	PRT_VGM_TOKEN
	JR	PRT_VGMHW4
PRT_VGMHWPSG1:
	LD	DE,MSGVGMPSG
	CALL	PRT_VGM_TOKEN
PRT_VGMHW4:
	RET

; DE -> token string, prints with comma separator when needed.
PRT_VGM_TOKEN:
	PUSH	DE
	LD	A,(VGMPRNSEP)
	OR	A
	JR	Z,PRT_VGM_TOKEN0
	LD	DE,MSGVGMCOM
	CALL	PRTSTR
PRT_VGM_TOKEN0:
	POP	DE
	CALL	PRTSTR
	LD	A,$FF
	LD	(VGMPRNSEP),A
	RET

; Setup VGM per-sample delay (once per goVGM): table row from integer MHz index,
; VGM_SCALE_FDLY_KHZ (reported KHz vs nominal MHz*1000), then VGM_PACK_TEMPO_DELAY.
; Pack applies an empirical rational chain (Q,W,W2,W3,W4) and splits W4 into
; vgmfdly0 (inner DJNZ) * vgmfdlo (outer rounds); see VGM_PACK_TEMPO_DELAY.
; Fine BPM: VGM_STRETCH_VGMDLY in vgm_player.inc scales each wait (vgmdly).
; MMU BNKCPY window refills (VGM_MMU_RD_SLFILL) add irregular CPU during decode.
VGM_SETFDELAY:
	LD	A,(VGMTMPMHZ)
	LD	HL,VGMCLKTBL-1
	ADD	A,L
	LD	L,A
	ADC	A,H
	SUB	L
	LD	H,A
	LD	A,(HL)
	OR	A
	JR	NZ,VGM_SF_TOK
	LD	A,10			; safe default for ~7 MHz class if table slot is 0
VGM_SF_TOK:
	CALL	VGM_SCALE_FDLY_KHZ
	CALL	VGM_PACK_TEMPO_DELAY
	XOR	A
	LD	(vgmfdcyc),A
	RET

; In: A = VGM_SCALE_FDLY_KHZ result (1..255). Out: vgmfdly0, vgmfdlo, vgmfdly.
; Chain: Q=(20*A+10)/11, W=(Q*119+44)/88, W2=(W*14+5)/11, W3=(W2*57+25)/50,
;       W4=(W3*44+20)/41; then outer=(W4+254)/255, inner=ceil(W4/outer).
VGM_PACK_TEMPO_DELAY:
	LD	E,A
	LD	D,0
	LD	HL,0
	LD	B,20
VGM_PK_M20:
	ADD	HL,DE
	DJNZ	VGM_PK_M20		; HL = 20*A
	LD	DE,10
	ADD	HL,DE			; round for /11
	LD	BC,11
	LD	DE,0
VGM_PK_D11:
	LD	A,H
	OR	L
	JR	Z,VGM_PK_Q
	OR	A
	SBC	HL,BC
	JR	C,VGM_PK_D11B
	INC	DE
	JR	VGM_PK_D11
VGM_PK_D11B:
	ADD	HL,BC
VGM_PK_Q:
	PUSH	DE
	POP	HL			; HL = Q
	EX	DE,HL			; DE = Q
	LD	HL,0
	LD	B,119
VGM_PK_M119:
	ADD	HL,DE
	DJNZ	VGM_PK_M119
	LD	DE,44
	ADD	HL,DE
	LD	BC,88
	LD	DE,0
VGM_PK_D88:
	LD	A,H
	OR	L
	JR	Z,VGM_PK_W0
	OR	A
	SBC	HL,BC
	JR	C,VGM_PK_D88B
	INC	DE
	JR	VGM_PK_D88
VGM_PK_D88B:
	ADD	HL,BC
VGM_PK_W0:
	PUSH	DE
	POP	HL			; HL = W
	LD	A,H
	OR	L
	JR	NZ,VGM_PK_WOK
	INC	L			; W >= 1
VGM_PK_WOK:
	EX	DE,HL			; DE = W
	LD	HL,0
	LD	B,14
VGM_PK_M14:
	ADD	HL,DE
	DJNZ	VGM_PK_M14
	LD	DE,5
	ADD	HL,DE			; round half for /11
	LD	BC,11
	LD	DE,0
VGM_PK_DW2:
	LD	A,H
	OR	L
	JR	Z,VGM_PK_W1
	OR	A
	SBC	HL,BC
	JR	C,VGM_PK_DW2B
	INC	DE
	JR	VGM_PK_DW2
VGM_PK_DW2B:
	ADD	HL,BC
VGM_PK_W1:
	PUSH	DE
	POP	HL			; HL = W2
	LD	A,H
	OR	L
	JR	NZ,VGM_PK_W2OK
	INC	L			; W2 >= 1
VGM_PK_W2OK:
	EX	DE,HL			; DE = W2
	LD	HL,0
	LD	B,57
VGM_PK_M57:
	ADD	HL,DE
	DJNZ	VGM_PK_M57
	LD	DE,25
	ADD	HL,DE			; round half for /50
	LD	BC,50
	LD	DE,0
VGM_PK_DW3:
	LD	A,H
	OR	L
	JR	Z,VGM_PK_W3
	OR	A
	SBC	HL,BC
	JR	C,VGM_PK_DW3B
	INC	DE
	JR	VGM_PK_DW3
VGM_PK_DW3B:
	ADD	HL,BC
VGM_PK_W3:
	PUSH	DE
	POP	HL			; HL = W3
	LD	A,H
	OR	L
	JR	NZ,VGM_PK_W3OK
	INC	L
VGM_PK_W3OK:
	EX	DE,HL			; DE = W3
	LD	HL,0
	LD	B,44
VGM_PK_M44:
	ADD	HL,DE
	DJNZ	VGM_PK_M44
	LD	DE,20
	ADD	HL,DE			; round half for /41
	LD	BC,41
	LD	DE,0
VGM_PK_DW4:
	LD	A,H
	OR	L
	JR	Z,VGM_PK_W4
	OR	A
	SBC	HL,BC
	JR	C,VGM_PK_DW4B
	INC	DE
	JR	VGM_PK_DW4
VGM_PK_DW4B:
	ADD	HL,BC
VGM_PK_W4:
	PUSH	DE
	POP	HL			; HL = W4
	LD	A,H
	OR	L
	JR	NZ,VGM_PK_W4OK
	INC	L
VGM_PK_W4OK:
	; outer = ceil(W4/255) via (W4+254)/255
	PUSH	HL
	LD	DE,254
	ADD	HL,DE
	LD	DE,255
	LD	B,0
VGM_PK_D255:
	LD	A,H
	OR	L
	JR	Z,VGM_PK_D255X
	OR	A
	SBC	HL,DE
	JR	C,VGM_PK_D255B
	INC	B
	JR	VGM_PK_D255
VGM_PK_D255B:
	ADD	HL,DE
VGM_PK_D255X:
	POP	HL			; HL = W4
	LD	A,B
	OR	A
	JR	NZ,VGM_PK_O0
	LD	B,1
VGM_PK_O0:
	LD	A,B
	LD	(TMP),A		; outer 1..255
	; HL = W4 + outer - 1, then inner = HL / outer
	LD	E,A
	LD	D,0
	DEC	DE			; DE = outer-1
	LD	A,D
	OR	E
	JR	Z,VGM_PK_SKAD
	ADD	HL,DE
VGM_PK_SKAD:
	LD	A,(TMP)
	LD	E,A
	LD	D,0
	LD	C,0
VGM_PK_DOUT:
	LD	A,H
	OR	L
	JR	Z,VGM_PK_DOUTX
	OR	A
	SBC	HL,DE
	JR	C,VGM_PK_DOUTB
	INC	C
	JR	VGM_PK_DOUT
VGM_PK_DOUTB:
	ADD	HL,DE
VGM_PK_DOUTX:
	LD	A,C
	OR	A
	JR	NZ,VGM_PK_I0
	LD	A,1
VGM_PK_I0:
	CP	255
	JR	C,VGM_PK_IC
	LD	A,255
VGM_PK_IC:
	LD	(vgmfdly0),A
	LD	A,(TMP)
	LD	(vgmfdlo),A
VGM_PK_FIN:
	LD	A,(vgmfdly0)
	LD	(vgmfdly),A
	RET

; In: A = table inner-loop count (non-zero). Uses VGMTMPMHZ, VGMTMPKHZ, TMP.
; Out: A = scaled count, clamped 1..255.
VGM_SCALE_FDLY_KHZ:
	LD	(TMP),A
	LD	A,(VGMTMPMHZ)
	OR	A
	LD	C,A
	JR	NZ,VGM_SK_MHZ
	LD	C,1
VGM_SK_MHZ:
	LD	B,C
	LD	HL,0
	LD	DE,1000
VGM_SK_NK:
	ADD	HL,DE
	DJNZ	VGM_SK_NK
	PUSH	HL			; nominal KHz = MHz*1000
	LD	A,(TMP)
	LD	B,A
	LD	HL,0
	LD	DE,(VGMTMPKHZ)
VGM_SK_PR:
	ADD	HL,DE
	DJNZ	VGM_SK_PR		; HL = T * reported KHz
	POP	BC			; BC = nominal KHz
	LD	A,H
	OR	L
	JR	Z,VGM_SK_QZ
	XOR	A
	LD	E,0
VGM_SK_DV:
	LD	D,H
	LD	A,L
	OR	D
	JR	Z,VGM_SK_D0
	OR	A
	SBC	HL,BC
	JR	C,VGM_SK_DB
	INC	E
	JR	VGM_SK_DV
VGM_SK_DB:
	ADD	HL,BC
VGM_SK_D0:
	LD	A,E
	OR	A
	JR	Z,VGM_SK_MIN1
	LD	D,A			; D = quotient
	LD	A,H
	OR	L
	JR	Z,VGM_SK_CAP0
	PUSH	BC
	ADD	HL,HL
	OR	A
	SBC	HL,BC
	POP	BC
	JR	C,VGM_SK_CAP0
	INC	D
VGM_SK_CAP0:
	LD	A,D
	JR	VGM_SK_CAP
VGM_SK_QZ:
	XOR	A
VGM_SK_MIN1:
	OR	A
	JR	NZ,VGM_SK_CAP
	LD	A,1
VGM_SK_CAP:
	CP	255
	RET	C
	LD	A,255
	RET

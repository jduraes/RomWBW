;
; Key control helpers for VibeTune refactor work.
; This first slice centralizes VGM key->action decoding so normal and
; pause loops share one mapping path.
;

; Decode a mapped control key into a KEYACT_* identifier.
; In:  A = key (raw or PLAYLIST_MAP_KEY output)
; Out: A = KEYACT_* (KEYACT_NONE if unsupported)
KEYACT_DECODE:
	CP	27			; ESC
	JR	Z,KEYACT_ESC0
	CP	'l'
	JR	Z,KEYACT_LOOPTRK0
	CP	'L'
	JR	Z,KEYACT_LOOPPLY0
	AND	$DF			; normalize to upper-case for alpha actions
	CP	'R'
	JR	Z,KEYACT_REDRAW0
	CP	'P'
	JR	Z,KEYACT_PREV0
	CP	'N'
	JR	Z,KEYACT_NEXT0
	CP	'A'
	JR	Z,KEYACT_NAV0
	CP	'D'
	JR	Z,KEYACT_NAV0
	CP	'W'
	JR	Z,KEYACT_NAV0
	CP	'S'
	JR	Z,KEYACT_NAV0
	XOR	A			; KEYACT_NONE
	RET

KEYACT_ESC0:
	LD	A,KEYACT_ESC
	RET

KEYACT_LOOPTRK0:
	LD	A,KEYACT_LOOPTRK
	RET

KEYACT_LOOPPLY0:
	LD	A,KEYACT_LOOPPLY
	RET

KEYACT_REDRAW0:
	LD	A,KEYACT_REDRAW
	RET

KEYACT_PREV0:
	LD	A,KEYACT_PREV
	RET

KEYACT_NEXT0:
	LD	A,KEYACT_NEXT
	RET

KEYACT_NAV0:
	LD	A,KEYACT_NAV
	RET

; Shared poll core for play and pause loops.
; In:  D bit7 = 0 play, 1 pause
; Out: B = 0 no-op, 1 pause-toggle/resume key, 2 delete, 3 action in C,
;      4 abort (play only)
;      C = KEYACT_* when B=3
KEY_POLL_CORE:
	CALL	GETKEY
	JR	Z,KEY_POLL_CORE_NONE
	CP	' '
	JR	Z,KEY_POLL_CORE_SPACE
	BIT	7,D
	JR	Z,KEY_POLL_CORE_KEY0
	CP	13			; ENTER also resumes when currently paused
	JR	Z,KEY_POLL_CORE_SPACE
KEY_POLL_CORE_KEY0:
	LD	E,A
	CALL	PLAYLIST_DELSEQ_CHECK
	CP	0
	JR	Z,KEY_POLL_CORE_DELETE
	CP	$FF
	JR	Z,KEY_POLL_CORE_NONE
	BIT	7,D
	JR	NZ,KEY_POLL_CORE_PAUSE
	LD	A,(ALLMD)
	OR	A
	JR	Z,KEY_POLL_CORE_ABORT
	JR	KEY_POLL_CORE_MAP
KEY_POLL_CORE_PAUSE:
	LD	A,(ALLMD)
	OR	A
	JR	Z,KEY_POLL_CORE_PAUSE0
	JR	KEY_POLL_CORE_MAP

KEY_POLL_CORE_MAP:
	LD	A,E
	CALL	PLAYLIST_MAP_KEY
	LD	E,A
KEY_POLL_CORE_DECODE:
	LD	A,E
	CALL	KEYACT_DECODE
	JR	KEY_POLL_CORE_ACTION
KEY_POLL_CORE_PAUSE0:
	JR	KEY_POLL_CORE_DECODE
KEY_POLL_CORE_ACTION:
	OR	A
	JR	Z,KEY_POLL_CORE_NONE
	LD	C,A
	LD	B,3
	RET
KEY_POLL_CORE_NONE:
	LD	B,0
	RET
KEY_POLL_CORE_SPACE:
	LD	B,1
	RET
KEY_POLL_CORE_DELETE:
	LD	B,2
	RET
KEY_POLL_CORE_ABORT:
	LD	B,4
	RET

; Handle a decoded action in either play or pause context.
; In:  A = KEYACT_*, E = mapped nav key
;      D bit0 = 0 PTX/MYM metadata, 1 VGM metadata
;      D bit7 = 0 play context, 1 pause context
; Out: B = 0 continue current loop, B = 1 caller should exit playback loop
KEY_HANDLE_ACTION:
	CP	KEYACT_ESC
	JR	Z,KEY_HANDLE_ACTION_ESC
	CP	KEYACT_LOOPTRK
	JR	Z,KEY_HANDLE_ACTION_LOOPTRK
	CP	KEYACT_LOOPPLY
	JR	Z,KEY_HANDLE_ACTION_LOOPPLY
	CP	KEYACT_REDRAW
	JR	Z,KEY_HANDLE_ACTION_REDRAW
	CP	KEYACT_PREV
	JR	Z,KEY_HANDLE_ACTION_PREV
	CP	KEYACT_NEXT
	JR	Z,KEY_HANDLE_ACTION_NEXT
	CP	KEYACT_NAV
	JP	Z,KEY_HANDLE_ACTION_NAV
	JP	KEY_HANDLE_ACTION_CONTINUE

KEY_HANDLE_ACTION_ESC:
	CALL	KEY_ABORT_MUTED
	LD	B,1
	RET

KEY_HANDLE_ACTION_LOOPTRK:
	LD	A,0			; select track loop mode
	CALL	KEY_TOGGLE_LOOP_MODE
	JP	KEY_HANDLE_ACTION_CONTINUE

KEY_HANDLE_ACTION_LOOPPLY:
	LD	A,1			; select playlist loop mode
	CALL	KEY_TOGGLE_LOOP_MODE
	JP	KEY_HANDLE_ACTION_CONTINUE

KEY_HANDLE_ACTION_REDRAW:
	BIT	7,D
	JR	NZ,KEY_HANDLE_ACTION_REDRAW_PAUSE
	CALL	KEY_REDRAW_PLAY_MUTE
	CALL	KEY_REDRAW_COMMON
	JR	KEY_HANDLE_ACTION_REDRAW_DONE

KEY_HANDLE_ACTION_REDRAW_DONE:
	JP	KEY_HANDLE_ACTION_CONTINUE
KEY_HANDLE_ACTION_REDRAW_PAUSE:
	CALL	KEY_REDRAW_COMMON
	JP	KEY_HANDLE_ACTION_CONTINUE

KEY_HANDLE_ACTION_PREV:
	BIT	7,D
	JR	NZ,KEY_HANDLE_ACTION_PREV0
	CALL	KEY_REQ_PREV
	LD	B,1
	RET
KEY_HANDLE_ACTION_PREV0:
	LD	A,(PLIDX)
	LD	(PLIDXOLD),A
	CALL	PLAYLIST_PREV
	JR	Z,KEY_HANDLE_ACTION_PREV1
	LD	A,$FF
	LD	(NAVREQ),A
	CALL	PAUSE_REFRESH_SELECTION
KEY_HANDLE_ACTION_PREV1:
	JP	KEY_HANDLE_ACTION_CONTINUE

KEY_HANDLE_ACTION_NEXT:
	BIT	7,D
	JR	NZ,KEY_HANDLE_ACTION_NEXT0
	CALL	KEY_REQ_NEXT
	LD	B,1
	RET
KEY_HANDLE_ACTION_NEXT0:
	LD	A,(PLIDX)
	LD	(PLIDXOLD),A
	CALL	PLAYLIST_ADVANCE
	JR	NZ,KEY_HANDLE_ACTION_NEXT1
	LD	A,(LOOPPLMD)
	OR	A
	JR	Z,KEY_HANDLE_ACTION_NEXT2
	CALL	PLAYLIST_RESTORE
KEY_HANDLE_ACTION_NEXT1:
	LD	A,$FF
	LD	(NAVREQ),A
	CALL	PAUSE_REFRESH_SELECTION
KEY_HANDLE_ACTION_NEXT2:
	JP	KEY_HANDLE_ACTION_CONTINUE

KEY_HANDLE_ACTION_NAV:
	BIT	7,D
	JR	NZ,KEY_HANDLE_ACTION_NAV0
	LD	A,E
	CALL	KEY_NAV_PLAY
	JR	Z,KEY_HANDLE_ACTION_NAV1
	LD	B,1
	RET
KEY_HANDLE_ACTION_NAV0:
	LD	A,E
	CALL	KEY_NAV_PLAY
	JR	Z,KEY_HANDLE_ACTION_NAV1
	CALL	PAUSE_REFRESH_SELECTION
KEY_HANDLE_ACTION_NAV1:
	JP	KEY_HANDLE_ACTION_CONTINUE

KEY_HANDLE_ACTION_CONTINUE:
	XOR	A
	LD	B,A
	RET

; Mute active playback path before redraw to avoid audible artifacts from
; concurrent register writes while UI output is in progress.
; In: D bit0 = 0 PTX/MYM, 1 VGM
KEY_REDRAW_PLAY_MUTE:
	BIT	0,D
	JR	NZ,KEY_REDRAW_PLAY_MUTE0
	CALL	MUTE_NOW
	RET
KEY_REDRAW_PLAY_MUTE0:
	CALL	VGM_MUTE_ALL
	RET

; Toggle loop modes in play/pause contexts.
; In: A = 0 track loop, A = 1 playlist loop
; Uses D bit7 to select play (LOOP_STATUS_POST) vs pause (PRTPAUSEMSG) status redraw.
KEY_TOGGLE_LOOP_MODE:
	OR	A
	JR	NZ,KEY_TOGGLE_LOOP_MODE_PLY
	LD	A,(LOOPTRKMD)
	OR	A
	JR	Z,KEY_TOGGLE_LOOP_MODE_TRK_ON
	XOR	A
	LD	(LOOPTRKMD),A
	JR	KEY_TOGGLE_LOOP_MODE_STAT
KEY_TOGGLE_LOOP_MODE_TRK_ON:
	LD	A,$FF
	LD	(LOOPTRKMD),A
	XOR	A
	LD	(LOOPPLMD),A
	JR	KEY_TOGGLE_LOOP_MODE_STAT

KEY_TOGGLE_LOOP_MODE_PLY:
	LD	A,(LOOPPLMD)
	OR	A
	JR	Z,KEY_TOGGLE_LOOP_MODE_PLY_ON
	XOR	A
	LD	(LOOPPLMD),A
	JR	KEY_TOGGLE_LOOP_MODE_STAT
KEY_TOGGLE_LOOP_MODE_PLY_ON:
	LD	A,$FF
	LD	(LOOPPLMD),A
	XOR	A
	LD	(LOOPTRKMD),A

KEY_TOGGLE_LOOP_MODE_STAT:
	CALL	SHOWLOOPSTATUS
	BIT	7,D
	JR	NZ,KEY_TOGGLE_LOOP_MODE_PAUSE
	CALL	LOOP_STATUS_POST
	RET
KEY_TOGGLE_LOOP_MODE_PAUSE:
	CALL	PRTPAUSEMSG
	RET

; Process normal-playlist navigation key (W/A/S/D).
; In:  A = mapped navigation key (W/A/S/D)
; Out: Z = no movement, NZ = movement accepted and NAVREQ set
KEY_NAV_PLAY:
	AND	$DF
	CALL	PLAYLIST_MOVE_WASD
	RET	Z
	LD	A,$FF
	LD	(NAVREQ),A
	OR	A
	RET

; Handle playlist delete sequence in shared key loops.
; Out: Z = continue playback, NZ = caller should exit current playback loop
KEY_DELETE_ATTEMPT:
	LD	A,(ALLMD)
	OR	A
	RET	Z
	CALL	PLAYLIST_CONFIRM_DELETE
	OR	A
	RET	Z
	CALL	PLAYLIST_DELETE_SELECTED
	OR	A
	RET

; Request next track.
KEY_REQ_NEXT:
	LD	A,$FF
	LD	(SKIPREQ),A
	RET

; Request previous track.
KEY_REQ_PREV:
	LD	A,$FF
	LD	(PREVREQ),A
	RET

; Signal playback abort/stop.
KEY_SET_STOPREQ:
	LD	A,$FF
	LD	(STOPREQ),A
	RET

; Abort playback with immediate mute.
KEY_ABORT_MUTED:
	CALL	MUTE_NOW
	CALL	KEY_SET_STOPREQ
	RET

; Enter pause mode and show pause status.
KEY_PAUSE_ON:
	LD	A,$FF
	LD	(PAUSEMD),A
	LD	A,(VGMFLAG)
	OR	A
	JR	Z,KEY_PAUSE_ON0
	CALL	VGM_MUTE_ALL
	JR	KEY_PAUSE_ON1
KEY_PAUSE_ON0:
	CALL	MUTE_NOW

KEY_PAUSE_ON1:
	CALL	PRTPAUSEMSG
	RET

; Leave pause mode.
; Out: NZ if NAVREQ is set (caller should exit), Z otherwise.
KEY_PAUSE_OFF:
	XOR	A
	LD	(PAUSEMD),A
	LD	A,(NAVREQ)
	OR	A
	RET	NZ
	CALL	PRTPLAYMSG
	XOR	A
	RET

; Toggle pause state.
; Out: NZ when pause is enabled, Z when pause is disabled.
KEY_TOGGLE_PAUSE:
	LD	A,(PAUSEMD)
	OR	A
	JR	Z,KEY_TOGGLE_PAUSE_ON
	CALL	KEY_PAUSE_OFF
	XOR	A
	RET
KEY_TOGGLE_PAUSE_ON:
	CALL	KEY_PAUSE_ON
	LD	A,$FF
	OR	A
	RET

; Shared redraw for play/pause and PTX/MYM vs VGM metadata modes.
; In: D bit7 = 0 play, 1 pause; D bit0 = 0 PTX/MYM, 1 VGM
KEY_REDRAW_COMMON:
	CALL	SHOWPLSTATUS
	LD	A,(UI_ACTIVE)
	OR	A
	RET	NZ			; ANSI mode: playlist-only redraw
	BIT	7,D
	JR	NZ,KEY_REDRAW_COMMON_PAUSE
	CALL	PRTPLAYINFO
	LD	A,(INFOLINE)
	OR	A
	JR	Z,KEY_REDRAW_COMMON_PLAY0
	CALL	CRLF2
	JR	KEY_REDRAW_COMMON_PLAY1
KEY_REDRAW_COMMON_PLAY0:
	CALL	CRLF

KEY_REDRAW_COMMON_PLAY1:
	BIT	0,D
	JR	NZ,KEY_REDRAW_COMMON_PLAYVGM
	CALL	PRTSONGMETA
	JR	KEY_REDRAW_COMMON_PLAYX
KEY_REDRAW_COMMON_PLAYVGM:
	CALL	PRTVGMMETA
KEY_REDRAW_COMMON_PLAYX:
	CALL	PRTPLAYMSG
	RET

KEY_REDRAW_COMMON_PAUSE:
	CALL	PRTPLAYINFO
	BIT	0,D
	JR	NZ,KEY_REDRAW_COMMON_PAUSEX
	CALL	PRTSONGMETA
KEY_REDRAW_COMMON_PAUSEX:
	CALL	PRTPAUSEMSG
	RET

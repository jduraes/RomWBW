;	mov l,b ! mvi h,0
;	lxi d,data$ports ! dad d
;	mov c,m ! inr c 
;	inp a				; get input status
;	ani 4 ! rz			; test transmitter empty
;	ori 0FFh ! ret			; return true if ready
;
;
;cent$stat:
;	in p$centstat ! cma
;	ani 20h ! rz
;	ori 0FFh ! ret	


;	db 'CRT1  '	; device 2, CRT port 1
;	db mb$in$out+mb$serial+mb$softbaud
;	db baud$9600
;	db 'CRT2  '	; device 3, CRT port 2
;	db mb$in$out+mb$serial+mb$softbaud
;	db baud$9600
;	db 'CRT3  '	; device 4, CRT port 3
;	db mb$in$out+mb$serial+mb$softbaud
;	db baud$9600

; [WBW] XMODEM trigger on CTRL-\
;
; The CTRL-\ key is sensed in ?ci above.  Instead of trying to load and
; run XM.COM from inside the BIOS (which re-entered BDOS while it was
; still servicing the console input call and crashed the system), we
; feed the command line "XM R FILEnn.TMP" back through CONIN one
; character per call, as if the user had typed it.  The shell then
; loads and runs XM.COM in the normal way.

xmodem_trigger:
	; Print message
	ld	hl,xm_msg
	call	print_msg
	
	; Bump persistent file counter, wrap 99 -> 0
	ld	a,(xm_counter)
	inc	a
	cp	100
	jr	c,no_wrap
	xor	a			; Wrap to 0
no_wrap:
	ld	(xm_counter),a
	ld	(file_num),a
	
	; Announce the filename that will be used
	ld	hl,launch_msg
	call	print_msg
	ld	a,(file_num)
	call	print_nn
	ld	hl,xm_ext_msg		; ".TMP" + CRLF
	call	print_msg
	
	; Build feed buffer: "XM R FILE" + nn + ".TMP" + CR
	ld	de,xm_feedbuf
	ld	hl,xm_cmd_text
	ld	bc,9			; "XM R FILE"
	ldir
	ld	a,(file_num)
	ld	c,0			; C = tens digit
ft$tens:
	cp	10
	jr	c,ft$tens$done
	sub	10
	inc	c
	jr	ft$tens
ft$tens$done:
	push	af			; Save ones
	ld	a,c
	add	a,'0'
	ld	(de),a
	inc	de
	pop	af
	add	a,'0'
	ld	(de),a
	inc	de
	ld	hl,xm_cmd_ext
	ld	bc,4			; ".TMP"
	ldir
	ld	a,0dh
	ld	(de),a			; Terminating CR
	
	; Initialise feed state and return the first macro char
	ld	hl,xm_feedbuf
	ld	(xm_feedptr),hl
	ld	a,16			; 9 + 2 + 4 + 1 chars
	ld	(xm_feedlen),a
	jr	xm_feed

xm_feed:
	; Serve next macro char instead of a hardware char
	ld	hl,(xm_feedptr)
	ld	a,(hl)
	inc	hl
	ld	(xm_feedptr),hl
	ld	hl,xm_feedlen
	dec	(hl)
	ret				; Char in A

print_nn:
	; Print A as two decimal digits (00-99)
	ld	c,0			; C = tens digit
pn$tens:
	cp	10
	jr	c,pn$tens$done
	sub	10
	inc	c
	jr	pn$tens
pn$tens$done:
	push	af			; Save ones
	ld	a,c
	add	a,'0'
	ld	e,a
	ld	c,b			; Unit number to C
	ld	b,01h			; HBIOS COUT
	rst	08
	pop	af
	add	a,'0'
	ld	e,a
	ld	c,b			; Unit number to C
	ld	b,01h			; HBIOS COUT
	rst	08
	ret
	
print_msg:
	ld	a,(hl)
	or	a
	ret	z
	push	hl
	ld	e,a
	ld	c,b
	ld	b,01h
	rst	08
	pop	hl
	inc	hl
	jr	print_msg

xm_msg:
	db	0dh,0ah
	db	'[CTRL-\ - Starting XMODEM receive]'
	db	0dh,0ah,0

launch_msg:
	db	'Receiving: FILE',0

xm_ext_msg:
	db	'.TMP'
	db	0dh,0ah,0

file_num:
	db	0

xm_counter:
	db	0			; Persistent counter for filename

xm_cmd_text:
	db	'XM R FILE'
xm_cmd_ext:
	db	'.TMP'

xm_feedbuf:
	ds	16			; "XM R FILE" + nn + ".TMP" + CR
xm_feedptr:
	dw	0
xm_feedlen:
	db	0

	end
